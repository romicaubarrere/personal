{
  "name": "romina-caubarrere-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "serve": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 4173",
    "reading:import": "node scripts/import-storygraph.mjs",
    "test": "npm run build && node --test",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "22.19.0",
    "npm": "11.9.0"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
