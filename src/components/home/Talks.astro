---
import { HOME_COPY, localizedPath, type HomeLanguage } from '../../data/home-copy';
interface Props { lang?: HomeLanguage }
const { lang = 'es' } = Astro.props;
const copy = HOME_COPY[lang];
---
  <section class="flyers" id="charlas">
    <div class="hd reveal">
      <h2>{copy.talksTitle[0]}<em>{copy.talksTitle[1]}</em></h2>
      <p class="hand" style="color:var(--ink-soft)">{copy.talksIntro}</p>
    </div>
    <div class="flywrap">
      <div class="flyer"><span class="pin" style="top:-8px;left:50%;transform:translateX(-50%)"></span><div class="yr hand">2026</div><span class="role">{copy.talks[0][0]}</span><h3>{copy.talks[0][1]}</h3><p>{copy.talks[0][2]}</p><div class="perf hand">{copy.talks[0][3]}</div></div>
      <div class="flyer"><span class="pin green" style="top:-8px;left:50%;transform:translateX(-50%)"></span><div class="yr hand">mar 2026</div><span class="role">{copy.talks[1][0]}</span><h3>{copy.talks[1][1]}</h3><p>{copy.talks[1][2]}</p><div class="perf hand">{copy.talks[1][3]}</div></div>
      <div class="flyer"><span class="pin gold" style="top:-8px;left:50%;transform:translateX(-50%)"></span><div class="yr hand">2025</div><span class="role">{copy.talks[2][0]}</span><h3>{copy.talks[2][1]}</h3><p>{copy.talks[2][2]}</p><div class="perf hand">{copy.talks[2][3]}</div></div>
    </div>
    <div class="talks-cta-wrap reveal" style="max-width:1120px;margin:38px auto 0;padding:0 40px;text-align:center">
      <a class="open-folder talks-cta" style="display:inline-flex" href={localizedPath(lang, 'comunidad-charlas.html')}>{copy.talksLink} <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
