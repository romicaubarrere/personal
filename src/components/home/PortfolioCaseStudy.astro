---
const repositoryUrl = 'https://github.com/romicaubarrere/personal';
const historyUrl = `${repositoryUrl}/blob/main/docs/project-history.md`;
const docsUrl = `${repositoryUrl}/tree/main/docs`;
import { HOME_COPY, type HomeLanguage } from '../../data/home-copy';
interface Props { lang?: HomeLanguage }
const { lang = 'es' } = Astro.props;
const copy = HOME_COPY[lang];
---

<section class="shelfsec" aria-labelledby="living-project-title">
  <div class="hd reveal">
    <h2 id="living-project-title">{copy.livingTitle[0]}<em>{copy.livingTitle[1]}</em></h2>
    <p>{copy.livingSubtitle}</p>
  </div>

  <div class="bookshelf">
    <article class="memo paper reveal">
      <span class="pin gold" aria-hidden="true"></span>
      <p class="big">{copy.livingBig}</p>
      <p set:html={copy.livingBody[0]}></p>
      <p>{copy.livingBody[1]}</p>

      <div class="tags" aria-label={copy.evidence}>
        <a class="ltag" href={historyUrl} target="_blank" rel="noopener noreferrer">{copy.history}<span class="sr-only">{copy.newTab}</span></a>
        <a class="ltag" href={docsUrl} target="_blank" rel="noopener noreferrer">{copy.documentation}<span class="sr-only">{copy.newTab}</span></a>
        <a class="ltag" href={repositoryUrl} target="_blank" rel="noopener noreferrer">{copy.repository}<span class="sr-only">{copy.newTab}</span></a>
      </div>
    </article>

    <div class="factnote reveal">
      <b>{copy.historyNote}</b><br />
      <small>{copy.historyDetail}</small>
    </div>
  </div>
</section>
