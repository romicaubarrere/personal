<script is:inline>
  (function(){
    var nav=document.getElementById('primary-nav');
    var toggle=document.getElementById('navToggle');
    if(!nav || !toggle) return;

    function mobileMenu(){
      return window.innerWidth<=760 || window.matchMedia('(max-width: 760px)').matches;
    }

    function modalOpen(){
      return document.body.classList.contains('modal-open');
    }

    function syncMenuInert(){
      if(modalOpen()) return;
      var shouldBeInert=mobileMenu() && toggle.getAttribute('aria-expanded')!=='true';
      nav.toggleAttribute('inert',shouldBeInert);
      nav.inert=shouldBeInert;
    }

    function scheduleMenuSync(){
      requestAnimationFrame(syncMenuInert);
      window.setTimeout(syncMenuInert,50);
      window.setTimeout(syncMenuInert,250);
      window.setTimeout(syncMenuInert,1000);
    }

    var bodyObserver=new MutationObserver(function(){
      if(!modalOpen()) scheduleMenuSync();
    });
    bodyObserver.observe(document.body,{attributes:true,attributeFilter:['class']});
    toggle.addEventListener('click',function(){requestAnimationFrame(syncMenuInert);});
    window.addEventListener('resize',syncMenuInert,{passive:true});
    window.addEventListener('pageshow',scheduleMenuSync);
    window.addEventListener('load',scheduleMenuSync);
    scheduleMenuSync();

    var links=Array.prototype.slice.call(document.querySelectorAll('#primary-nav a[href^="#"]'));
    var validIds=new Set(links.map(function(link){return link.getAttribute('href').slice(1);}));

    function syncHashActive(){
      var id=window.location.hash.slice(1);
      if(!validIds.has(id)) return;
      links.forEach(function(link){
        var active=link.getAttribute('href')==='#'+id;
        link.classList.toggle('is-active',active);
        if(active) link.setAttribute('aria-current','location');
        else link.removeAttribute('aria-current');
      });
    }

    function syncHistory(){
      syncHashActive();
      requestAnimationFrame(syncHashActive);
      window.setTimeout(syncHashActive,50);
      window.setTimeout(syncHashActive,250);
    }
    window.addEventListener('hashchange',syncHistory);
    window.addEventListener('popstate',syncHistory);
    window.addEventListener('pageshow',syncHistory);
    syncHistory();
  })();
</script>
