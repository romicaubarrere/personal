---
import LanguageSwitcher from './LanguageSwitcher.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/formation.css';

type Lang = 'en' | 'pt';
type Page = 'work' | 'community' | 'education';
interface Item { meta?: string; title: string; body: string }
interface Section { id: string; eyebrow: string; title: string; intro: string; items: Item[] }
interface Copy { title: string; description: string; kicker: string; heading: string; lede: string; record: string; note: string; sections: Section[]; footer: string }
interface Props { lang: Lang; page: Page }

const { lang, page } = Astro.props;
const base = 'https://romicaubarrere.github.io/personal/';
const slugs = { work: 'como-trabajo', community: 'comunidad-charlas', education: 'formacion' } as const;
const slug = slugs[page];

