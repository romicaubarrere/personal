---
import BaseLayout from './BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/post.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  summary: string;
  dateTime: string;
  dateLabel: string;
  lang?: 'es' | 'en' | 'pt';
  page?: 'questions' | 'when-you-can';
  alternates?: { lang: string; href: string }[];
}

const { title, description, canonical, summary, dateTime, dateLabel, lang = 'es', page, alternates = [] } = Astro.props;
const labels = {
  es: { skip: 'Saltar al contenido', back: 'volver a lo que leo y escribo', kicker: 'una nota mía', footer: 'hecho con método, plantas y un poco de lana', privacy: 'Privacidad' },
  en: { skip: 'Skip to content', back: 'back to what I read and write', kicker: 'a note of my own', footer: 'made with method, plants and a little yarn', privacy: 'Privacy' },
  pt: { skip: 'Pular para o conteúdo', back: 'voltar ao que leio e escrevo', kicker: 'uma nota minha', footer: 'feito com método, plantas e um pouco de lã', privacy: 'Privacidade' }
} as const;
const copy = labels[lang];
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title.replace(/\s+\|\s+Romina Caubarrere$/, ''),
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  datePublished: dateTime,
  inLanguage: lang,
  isPartOf: { '@id': 'https://romicaubarrere.github.io/personal/#website' },
  author: {
    '@id': 'https://romicaubarrere.github.io/personal/#person',
    '@type': 'Person',
    name: 'Romina Caubarrere',
    url: 'https://romicaubarrere.github.io/personal/',
    sameAs: ['https://www.linkedin.com/in/rominacaubarrere/']
  }
};
---

<BaseLayout {lang} ogLocale={lang === 'en' ? 'en_US' : lang === 'pt' ? 'pt_BR' : 'es_UY'} {title} {description} {canonical} {alternates} ogType="article">
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(article)}
  ></script>

  <a class="skip-link" href="#main-content">{copy.skip}</a>
  {page && <LanguageSwitcher current={lang} {page} />}
  <header class="top brick">
    <div class="hero">
      <a class="back" href={lang === 'es' ? '/personal/#lecturas' : `../../${lang}.html#overview`}>← {copy.back}</a><br />
      <span class="kicker">{copy.kicker}</span>
      <h1><slot name="heading" /></h1>
      <p class="summary">{summary}</p>
      <div class="meta">Romina Caubarrere · <time datetime={dateTime}>{dateLabel}</time></div>
    </div>
  </header>
  <main class="cork" id="main-content" tabindex="-1">
    <article class="paper">
      <span class="tape" aria-hidden="true"></span>
      <slot />
    </article>
  </main>
  <footer class="footer">{copy.footer} · <a href={lang === 'es' ? '/personal/' : `../../${lang}.html`}>Romina Caubarrere</a> · <a href={lang === 'es' ? '../privacidad.html' : `../${lang === 'en' ? 'privacy' : 'privacidade'}.html`}>{copy.privacy}</a></footer>
</BaseLayout>
