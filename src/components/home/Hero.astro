---
import { HOME_COPY, type HomeLanguage } from '../../data/home-copy';
interface Props { lang?: HomeLanguage }
const { lang = 'es' } = Astro.props;
const copy = HOME_COPY[lang];
const heroMessage = {
  es: 'Hago muchas preguntas, ordeno lo complejo y convierto decisiones en un plan que el equipo puede ejecutar.',
  en: 'I ask a lot of questions, bring order to complexity and turn decisions into a plan the team can execute.',
  pt: 'Faço muitas perguntas, organizo a complexidade e transformo decisões em um plano que a equipe consegue executar.'
}[lang];
---
  <header class="hero brick" id="top">
    <div class="special-date-layer" id="specialDateLayer" aria-hidden="true" hidden>
      <div class="birthday-decor">
        <div class="birthday-garland">
          <i class="birthday-flag" style="left:8%"></i><i class="birthday-flag" style="left:20%"></i>
          <i class="birthday-flag" style="left:32%"></i><i class="birthday-flag" style="left:44%"></i>
          <i class="birthday-flag" style="left:56%"></i><i class="birthday-flag" style="left:68%"></i>
          <i class="birthday-flag" style="left:80%"></i>
        </div>
        <div id="birthdayConfetti"></div>
      </div>
      <div class="halloween-decor">
        <span class="crochet-web"></span>
        <span class="halloween-moon"></span>
        <i class="paper-bat one"></i><i class="paper-bat two"></i><i class="paper-bat three"></i>
        <span class="crochet-pumpkin"></span>
      </div>
      <div class="patriotic-decor">
        <span class="patriotic-ribbon"></span>
        <span class="patriotic-rosette"></span>
      </div>
    </div>
    <div class="ironshelf"></div>
    <svg class="hang l parallax" data-depth="26" viewBox="0 0 240 240" style="overflow:visible" aria-hidden="true" focusable="false"><use href="#fern"/></svg>
    <svg class="hang lb parallax" data-depth="34" viewBox="0 0 240 240" style="overflow:visible" aria-hidden="true" focusable="false"><use href="#fern"/></svg>
    <svg class="hang r parallax" data-depth="18" viewBox="0 0 240 240" style="overflow:visible" aria-hidden="true" focusable="false"><use href="#fern"/></svg>
    <svg class="hang rb parallax" data-depth="30" viewBox="0 0 240 240" style="overflow:visible" aria-hidden="true" focusable="false"><use href="#fern"/></svg>

    <div class="scrim"></div>
    <div class="spot" id="spot"></div>
    <div class="vign"></div>

    <div class="stage">
      <div class="titlewrap">
        <span class="kick hand">{copy.hello}</span>
        <h1 class="bigname">Romina<span class="l2">Caubarrere</span></h1>
        <div class="rolebar">{copy.role}</div>
        <p class="hero-copy">{heroMessage}</p>
        <div class="special-date-badge" id="specialDateBadge" role="status" aria-live="polite" hidden></div>
        <div class="hero-actions" aria-label={copy.actionsLabel}>
          <a class="hero-link primary" href="#proyectos" data-analytics-event="view_projects_click">{copy.heroActions[0]}</a>
          <a class="hero-link" href="#contacto">{copy.heroActions[1]}</a>
        </div>
      </div>

      <div class="photo-tack">
        <span class="tape rose" style="top:-14px;left:50%;transform:translateX(-50%) rotate(3deg);"></span>
        <div class="polaroid">
          <div class="portrait-mark" aria-hidden="true">
            <span class="portrait-initials">RC</span>
            <span class="portrait-role">PM</span>
          </div>
          <span class="cap">Romi</span>
        </div>
      </div>

      <div class="stickynote">
        <span class="pin gold" style="top:-9px;left:50%;transform:translateX(-50%);"></span>
        {copy.sticky.split(' + ')[0]} <b>+</b><br>{copy.sticky.split(' + ')[1]}
      </div>
    </div>

    <div class="scrollhint">{copy.scroll}<span>&darr;</span></div>
  </header>

<style is:global>
  .hero-actions .hero-link{position:relative;isolation:isolate;overflow:visible;border:0;border-radius:7px;background:rgba(22,19,16,.72);box-shadow:0 5px 0 rgba(0,0,0,.25),inset 0 0 0 1px rgba(250,243,228,.22);transform:rotate(.45deg)}
  .hero-actions .hero-link.primary{background:var(--cream);color:var(--ink);transform:rotate(-.7deg);box-shadow:0 5px 0 rgba(0,0,0,.28),inset 0 0 0 1px rgba(36,31,24,.12)}
  .hero-actions .hero-link::before{content:"";position:absolute;inset:4px;border:1.5px dashed currentColor;border-radius:4px;opacity:.48;pointer-events:none}
  .hero-actions .hero-link::after{content:"";position:absolute;right:-8px;bottom:7px;width:20px;height:8px;border-bottom:2px solid var(--gold);border-radius:50%;transform:rotate(18deg);transform-origin:left center;transition:transform .2s ease,width .2s ease;pointer-events:none}
  .hero-actions .hero-link:is(:hover,:focus-visible){transform:translateY(-3px) rotate(0);box-shadow:0 8px 0 rgba(0,0,0,.24),inset 0 0 0 1px rgba(250,243,228,.22)}
  .hero-actions .hero-link.primary:is(:hover,:focus-visible){box-shadow:0 8px 0 rgba(0,0,0,.26),inset 0 0 0 1px rgba(36,31,24,.12)}
  .hero-actions .hero-link:is(:hover,:focus-visible)::after{width:31px;transform:rotate(6deg) translateX(2px)}
  .hero-actions .hero-link:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
  @media(max-width:520px){.hero-actions{gap:10px}.hero-actions .hero-link{min-width:132px}}
  @media(prefers-reduced-motion:reduce){.hero-actions .hero-link,.hero-actions .hero-link::after{transition:none}.hero-actions .hero-link:is(:hover,:focus-visible),.hero-actions .hero-link.primary:is(:hover,:focus-visible){transform:none}.hero-actions .hero-link:is(:hover,:focus-visible)::after{width:20px;transform:rotate(18deg)}}
</style>
