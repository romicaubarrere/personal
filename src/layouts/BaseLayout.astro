---
interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  themeColor?: string;
  ogType?: 'website' | 'article';
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  extraStylesheets?: string[];
}

const {
  title,
  description,
  canonical,
  robots = 'index,follow',
  themeColor = '#22432c',
  ogType = 'website',
  ogDescription = description,
  ogImage,
  ogImageAlt,
  extraStylesheets = []
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ?? new URL(canonical);
const resolvedOgImage = ogImage ?? new URL(`${base}social-preview.png`, siteUrl).href;
const resolvedOgImageAlt = ogImageAlt ?? 'Tarjeta del portfolio de Romina Caubarrere, Project Manager de software.';
const homeCanonical = 'https://romicaubarrere.github.io/personal/';
const breadcrumbData = canonical !== homeCanonical && !robots.includes('noindex')
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: homeCanonical
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title.replace(/\s+\|\s+Romina Caubarrere$/, ''),
          item: canonical
        }
      ]
    }
  : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Romina Caubarrere" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="me" href="https://www.linkedin.com/in/rominacaubarrere/" />
    <link rel="alternate" type="application/rss+xml" title="Notas de Romina Caubarrere" href={`${base}feed.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content="El estudio de Romi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,400..700&family=DM+Sans:opsz,wght@9..40,400..700&family=Caveat:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {extraStylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <slot name="head" />
    {breadcrumbData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbData, null, 2)}
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
