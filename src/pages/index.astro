---
import About from '../components/home/About.astro';
import Chrome from '../components/home/Chrome.astro';
import Contact from '../components/home/Contact.astro';
import Footer from '../components/home/Footer.astro';
import Hero from '../components/home/Hero.astro';
import HomeScripts from '../components/home/HomeScripts.astro';
import PortfolioCaseStudy from '../components/home/PortfolioCaseStudy.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ProjectBookcase from '../components/islands/ProjectBookcase';
import Reads from '../components/home/Reads.astro';
import StudioTransition from '../components/home/StudioTransition.astro';
import Talks from '../components/home/Talks.astro';
import WorkTeaser from '../components/home/WorkTeaser.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const title = 'Romina Caubarrere | Project Manager de software';
const description = 'Portfolio de Romina Caubarrere, Project Manager de software: proyectos, experiencia y una forma de trabajo que conecta personas, producto y tecnología.';
const socialDescription = 'Conecto personas, producto y tecnología para que proyectos complejos avancen y lleguen a resultados.';
const canonical = 'https://romicaubarrere.github.io/personal/';
const socialImage = 'https://romicaubarrere.github.io/personal/social-preview.png';
const socialImageAlt = 'Tarjeta del portfolio de Romina Caubarrere, Project Manager de software.';
const alternates = [
  { lang: 'es', href: canonical },
  { lang: 'en', href: 'https://romicaubarrere.github.io/personal/en.html' },
  { lang: 'pt', href: 'https://romicaubarrere.github.io/personal/pt.html' },
  { lang: 'x-default', href: canonical }
];
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const person = {
  '@id': `${canonical}#person`,
  '@type': 'Person',
  name: 'Romina Caubarrere',
  url: canonical,
  jobTitle: 'Project Manager de software',
  description: 'Project Manager de software con experiencia en producto, gestión de proyectos y calidad.',
  sameAs: [
    'https://www.linkedin.com/in/rominacaubarrere/'
  ],
  knowsAbout: [
    'Gestión de proyectos de software',
    'Producto digital',
    'Testing y calidad'
  ]
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@id': `${canonical}#website`,
      '@type': 'WebSite',
      name: 'El estudio de Romi',
      url: canonical,
      inLanguage: 'es'
    },
    {
      '@id': `${canonical}#profile`,
      '@type': 'ProfilePage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'es',
      isPartOf: { '@id': `${canonical}#website` },
      mainEntity: { '@id': `${canonical}#person` }
    },
    person
  ]
};
---

<BaseLayout
  {title}
  {description}
  {canonical}
  ogDescription={socialDescription}
  ogImage={socialImage}
  ogImageAlt={socialImageAlt}
  {alternates}
  extraStylesheets={[`${base}microinteractions.css`]}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData, null, 2)}
  ></script>

  <Chrome />
  <LanguageSwitcher current="es" />
  <main id="main-content" tabindex="-1">
    <Hero />
    <About />
    <ProjectBookcase client:idle />
    <StudioTransition />
    <PortfolioCaseStudy />
    <WorkTeaser />
    <StudioTransition />
    <Talks />
    <Reads />
    <StudioTransition />
    <Contact />
  </main>
  <Footer />
  <HomeScripts />
  <script is:inline src={`${base}contextual-scribbles.js`} defer></script>
</BaseLayout>
