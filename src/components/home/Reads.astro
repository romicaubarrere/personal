---
import { currentReading } from '../../data/reading';
import { HOME_COPY, type HomeLanguage } from '../../data/home-copy';
interface Props { lang?: HomeLanguage }
const { lang = 'es' } = Astro.props;
const copy = HOME_COPY[lang];
---

  <section class="reads" id="lecturas">
    <style is:inline>
      .sticky-link.is-lifting{animation:paper-lift .17s cubic-bezier(.2,.75,.3,1) both}
      @keyframes paper-lift{to{transform:rotate(0) translateY(-12px) scale(.985);opacity:.82;box-shadow:7px 18px 25px rgba(0,0,0,.22)}}
      .reading-ledger-link{display:inline-flex;align-items:center;min-height:44px;margin-top:17px;padding:8px 12px;background:var(--gold);color:var(--ink);font-family:var(--hand);font-size:1.05rem;font-weight:700;text-decoration:none;box-shadow:3px 4px 0 rgba(36,31,24,.18);transform:rotate(-1deg);transition:transform .18s ease,box-shadow .18s ease}
      .reading-ledger-link:is(:hover,:focus-visible){transform:rotate(0) translateY(-2px);box-shadow:4px 6px 0 rgba(36,31,24,.2)}
      @media(prefers-reduced-motion:reduce){.sticky-link.is-lifting{animation:none}}
      @media(prefers-reduced-motion:reduce){.reading-ledger-link{transition:none;transform:none!important}}
    </style>
    <div class="hd reveal">
      <h2>{copy.readsTitle[0]}<em>{copy.readsTitle[1]}</em>{copy.readsTitle[2]}</h2>
    </div>
    <div class="rgrid">
      <div class="nowbook reveal" style="--r:-1.5deg">
        <span class="pin" style="top:-9px;left:34px;"></span>
        <div class="lbl hand">{copy.readingNow}</div>
        <div class="bk">
          <div class="cover" aria-hidden="true"><span>{currentReading.coverLabel}</span></div>
          <div>
            <div class="bt">{currentReading.title}</div>
            <div class="ba">{copy.by} {currentReading.author}</div>
            <time class="ba" datetime={currentReading.updatedAt}>
              {copy.updated}
            </time>
          </div>
        </div>
        <p class="shelf-note">{copy.shelfNote}</p>
        <a class="reading-ledger-link" href="lecturas.html" hreflang={lang === 'es' ? undefined : 'es'}>{copy.readingLink}</a>
        <div class="note-h">{copy.hobby}</div>
        <p class="language-note">{copy.languages}</p>
      </div>
      <div>
        <p class="hand" style="font-size:22px;color:var(--ink-soft);margin-bottom:14px">{copy.notes}</p>
        <div class="stickies">
          <a class="sticky sticky-link" href={copy.noteRoutes[0]} aria-label={copy.noteTitles[0]}>
            <small>{copy.published}</small>
            <span class="sticky-title">{copy.noteTitles[0]}</span>
            <span class="sticky-desc">{copy.noteDescriptions[0]}</span>
          </a>
          <a class="sticky sticky-link" href={copy.noteRoutes[1]} aria-label={copy.noteTitles[1]}>
            <small>{copy.published}</small>
            <span class="sticky-title">{copy.noteTitles[1]}</span>
            <span class="sticky-desc">{copy.noteDescriptions[1]}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
