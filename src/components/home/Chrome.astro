      <g id="pot">
        <path d="M40 118 h44 l-7 30 h-30 z" fill="#b5643f" stroke="#7a3f24" stroke-width="2"/>
        <path d="M36 118 h52 l-3 10 h-46 z" fill="#c47a52" stroke="#7a3f24" stroke-width="2"/>
        <g stroke="#3f5233" stroke-width="2" fill="#5c6b3f">
          <path d="M62 120 C60 96 46 84 38 70" fill="none"/>
          <ellipse cx="34" cy="64" rx="15" ry="9" transform="rotate(-38 34 64)"/>
          <path d="M62 120 C64 92 80 82 90 66" fill="none"/>
          <ellipse cx="94" cy="60" rx="15" ry="9" transform="rotate(34 94 60)" fill="#6f7a54"/>
          <path d="M62 120 C60 88 58 60 58 40" fill="none"/>
          <ellipse cx="58" cy="34" rx="11" ry="16" fill="#6f7a54"/>
          <path d="M62 120 C66 96 74 78 82 58" fill="none"/>
          <ellipse cx="84" cy="52" rx="11" ry="15" transform="rotate(24 84 52)" fill="#55603f"/>
          <path d="M62 120 C58 96 48 80 42 60" fill="none"/>
          <ellipse cx="40" cy="54" rx="11" ry="15" transform="rotate(-22 40 54)" fill="#55603f"/>
        </g>
      </g>
    </defs>
  </svg>

  <button class="nav-toggle" id="navToggle" type="button" aria-controls="primary-nav" aria-expanded="false">
    <span>{copy.menu}</span><span class="menu-icon" aria-hidden="true">&#9776;</span>
  </button>
  <nav id="primary-nav" aria-label={copy.navLabel}>
    <a href="#sobre">{copy.nav[0]}</a>
    <a href="#proyectos">{copy.nav[1]}</a>
    <a href="#forma-de-trabajo">{copy.nav[2]}</a>
    <a href="#charlas">{copy.nav[3]}</a>
    <a href="#lecturas">{copy.nav[4]}</a>
    <a href="#contacto">{copy.nav[5]}</a>
  </nav>
