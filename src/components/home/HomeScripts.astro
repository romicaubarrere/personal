<script is:inline>
  var CASE_PAGE_ORDER = [
    {key:'context', title:'Contexto'},
    {key:'challenge', title:'Desafío'},
    {key:'role', title:'Rol de Romina'},
    {key:'team', title:'Equipo y stakeholders'},
    {key:'decisions', title:'Decisiones y acciones'},
    {key:'results', title:'Resultados'},
    {key:'learnings', title:'Aprendizajes'}
  ];

  function makeBookCase(data){
    var pages=[{cover:true,title:data.title,sub:data.subtitle}];
    var sections=data.sections||{};
    CASE_PAGE_ORDER.forEach(function(definition){
      var html=sections[definition.key];
      if(!html) return;
      pages.push({h:definition.title,html:html});
    });
    return {tag:data.tag,color:data.color,pages:pages};
  }

  var BOOKS = {
    eagerworks:makeBookCase({
      tag:'Gestión · software',color:'#3f7d4e',title:'eagerworks',subtitle:'un proyecto real',
      sections:{
        context:'<em>Contá qué era: el producto, el equipo y el desafío que había.</em>',
        role:'<em>Qué hiciste vos como PM: cómo coordinaste, qué decisiones tomaste.</em>',
        results:'<em>Cómo terminó. Un número o un momento concreto vale oro.</em>'
      }
    }),
    fisica:makeBookCase({
      tag:'Divulgación · premiado en EEUU',color:'#8f4230',title:'Física Mente Posible',subtitle:'divulgar la física',
      sections:{
        context:'Un proyecto de divulgación de Física que cofundé, reconocido en Estados Unidos.',
        role:'Cofundadora. <em>Contá qué parte llevaste: contenidos, difusión, equipo.</em>',
        results:'<em>El reconocimiento en EEUU y lo que significó para vos.</em>'
      }
    }),
    pmi:makeBookCase({
      tag:'Alianzas · comunidad',color:'#cf9a3f',title:'Club Jóvenes Líderes PMI',subtitle:'VP de Alianzas',
      sections:{
        context:'Club de Jóvenes Líderes de Proyectos de PMI Nuevo Cuyo.',
        role:'Vicepresidenta de Alianzas. <em>Contá qué alianzas armaste.</em>',
        results:'<em>Qué lograron juntos.</em>'
      }
    }),
    habitar:makeBookCase({
      tag:'Producto · gestión · calidad',color:'#55603f',title:'habITar',subtitle:'proyecto final de UTEC',
      sections:{
        context:'Proyecto final de la Licenciatura en Tecnologías de la Información de UTEC. Durante 46 semanas, un equipo de tres personas desarrolló una plataforma para centralizar la gestión económica, administrativa y comunitaria de una cooperativa de vivienda uruguaya.',
        challenge:'La información y los procesos se repartían entre canales informales y registros manuales. Eso hacía difícil seguir pagos, decisiones y tareas. A la vez, el equipo tenía que cubrir un MVP amplio mientras sus integrantes trabajaban y la disponibilidad de las personas usuarias era limitada.',
        role:'Me ocupé de la gestión del proyecto, la definición y priorización del producto y el testing manual. Organicé el backlog, llevé la matriz de riesgos, coordiné las validaciones y convertí 63 requisitos <em>must have</em> en un alcance verificable.',
        team:'Trabajé con Diego Furiati en desarrollo y Alejandro Hernández en infraestructura y ciberseguridad. El equipo registró 2.466 horas de trabajo. Nos organizamos en sprints quincenales, con encuentros tres veces por semana y seguimiento asincrónico.',
        decisions:'Adaptamos Scrum a la disponibilidad real: mantuvimos revisiones internas por sprint y concentramos la participación de la cooperativa en hitos con valor tangible. Priorizamos el MVP con MoSCoW y definimos una estrategia de calidad que combinó pruebas manuales, automatizadas, de rendimiento y de seguridad.',
        results:'Llegamos a la defensa técnica final el 14 de agosto de 2026 con una versión funcional que integraba cuotas y morosidad, mantenimiento, reservas, eventos, comunicados y votaciones. La validación incluyó 226 casos manuales, más de 2.700 pruebas automatizadas y seis suites.',
        learnings:'El proyecto confirmó que adaptar el método no es aflojarlo: es sostener sus objetivos con una dinámica que el equipo y las personas usuarias puedan mantener. También dejó una regla clara: una tecnología compleja solo aporta valor si la experiencia sigue siendo simple.'
      }
    }),
    p5:makeBookCase({
      tag:'Sumamos',color:'#7a3450',title:'Y otro más',subtitle:'hay lugar de sobra',
      sections:{context:'<em>Otro proyecto, otra historia. Lo llenamos juntas.</em>'}
    })
  };

  (function(){
    var modal=document.getElementById('bookmodal');
    var pgL=document.getElementById('pgL'), pgR=document.getElementById('pgR');
    var leaf=document.getElementById('leaf'), lfF=document.getElementById('lfF'), lfB=document.getElementById('lfB');
    var pnum=document.getElementById('pnum');
    var prevButton=document.getElementById('bmPrev'), nextButton=document.getElementById('bmNext');
    var dialogTitle=document.getElementById('bookDialogTitle');
    var closeButton=modal.querySelector('.bm-close');
    var mobileBookQuery=window.matchMedia ? window.matchMedia('(max-width: 720px)') : {matches:false};
    var lastFocus=null;
    var currentBookKey=null, openedFromPage=false;
    var pages=[], pageCount=0, pageIndex=0, spread=0, animating=false, curColor='#3f7d4e', curTag='';

    function projectUrl(key,index){
      return window.location.pathname+window.location.search+'#project='+encodeURIComponent(key)+'&page='+index;
    }
    function projectFromUrl(){
      if(window.location.hash.indexOf('#project=')!==0) return null;
      var params=new URLSearchParams(window.location.hash.slice(1));
      var key=params.get('project');
      if(!BOOKS[key]) return null;
      var index=parseInt(params.get('page'),10);
      return {key:key,index:Number.isFinite(index) ? index : 0};
    }
    function updateProjectUrl(mode){
      if(!currentBookKey) return;
      window.history[mode||'replaceState']({portfolioProject:true},'',projectUrl(currentBookKey,pageIndex));
    }

    function esc(s){return s||'';}
    function pageHTML(pg){
      if(!pg) return '<div class="pgc"><div class="pfoot">&#10086;</div></div>';
      if(pg.cover) return '<div class="pgc cover" style="--bc:'+curColor+'"><div class="emblem">&#10022;</div><div class="ctag">'+esc(curTag)+'</div><h3>'+esc(pg.title)+'</h3><div class="kbig">'+esc(pg.sub)+'</div></div>';
      return '<div class="pgc"><div class="kbig">'+esc(pg.h)+'</div><div class="pbody">'+esc(pg.html)+'</div><div class="pfoot">&#10047;</div></div>';
    }
    function spreads(){return Math.ceil(pages.length/2);}
    function isMobileBook(){return mobileBookQuery.matches;}
    function updateControls(){
      prevButton.disabled=isMobileBook() ? pageIndex<=0 : spread<=0;
      nextButton.disabled=isMobileBook() ? pageIndex+1>=pageCount : (spread+1)*2>=pages.length;
    }
    function render(){
      if(isMobileBook()){
        pgL.innerHTML='';
        pgR.innerHTML=pageHTML(pages[pageIndex]);
        pnum.textContent=(pageIndex+1)+' / '+pageCount;
      }else{
        pgL.innerHTML=pageHTML(pages[spread*2]);
        pgR.innerHTML=pageHTML(pages[spread*2+1]);
        pnum.textContent=(spread+1)+' / '+spreads();
      }
      updateControls();
    }

    function setBackgroundInert(inactive){
      Array.prototype.forEach.call(document.body.children,function(element){
        if(element!==modal && element.tagName!=='SCRIPT') element.inert=inactive;
      });
    }
    function focusableElements(){
      return Array.prototype.filter.call(
        modal.querySelectorAll('button:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])'),
        function(element){return element.offsetParent!==null;}
      );
    }
    function openBook(key,trigger,options){
      var b=BOOKS[key]; if(!b) return;
      options=options||{};
      lastFocus=trigger||document.activeElement;
      currentBookKey=key;
      curColor=b.color; curTag=b.tag; pages=b.pages.slice();
      pageCount=pages.length;
      pageIndex=Math.max(0,Math.min(Number(options.page)||0,pageCount-1));
      if(pages.length%2) pages.push(null);
      spread=Math.floor(pageIndex/2); render();
      dialogTitle.textContent='Proyecto: '+b.pages[0].title;
      leaf.classList.add('hide');
      modal.classList.add('open'); modal.setAttribute('aria-hidden','false');
      document.body.classList.add('modal-open');
      setBackgroundInert(true);
      if(options.history!==false){
        openedFromPage=true;
        updateProjectUrl('pushState');
      }
      if(options.focus!==false) closeButton.focus({preventScroll:true});
    }
    function closeBook(options){
      if(!modal.classList.contains('open')) return;
      options=options||{};
      modal.classList.remove('open'); modal.setAttribute('aria-hidden','true');
      document.body.classList.remove('modal-open');
      setBackgroundInert(false);
      if(lastFocus && lastFocus.isConnected) lastFocus.focus({preventScroll:true});
      lastFocus=null; currentBookKey=null;
      if(options.history!==false){
        if(openedFromPage) window.history.back();
        else window.history.replaceState(null,'',window.location.pathname+window.location.search);
      }
      openedFromPage=false;
    }

    function next(){
      if(animating) return;
      if(isMobileBook()){
        if(pageIndex+1>=pageCount) return;
        pageIndex+=1; render(); updateProjectUrl(); return;
      }
      if((spread+1)*2>=pages.length) return; animating=true;
      lfF.innerHTML=pageHTML(pages[spread*2+1]);
      lfB.innerHTML=pageHTML(pages[spread*2+2]);
      pgR.innerHTML=pageHTML(pages[spread*2+3]);
      leaf.classList.remove('hide'); leaf.classList.add('notrans'); leaf.style.transform='rotateY(0deg)';
      void leaf.offsetWidth; leaf.classList.remove('notrans'); leaf.style.transform='rotateY(-180deg)';
    }
    function prev(){
      if(animating) return;
      if(isMobileBook()){
        if(pageIndex<=0) return;
        pageIndex-=1; render(); updateProjectUrl(); return;
      }
      if(spread<=0) return; animating=true;
      lfB.innerHTML=pageHTML(pages[spread*2]);
      lfF.innerHTML=pageHTML(pages[(spread-1)*2+1]);
      pgL.innerHTML=pageHTML(pages[(spread-1)*2]);
      leaf.classList.remove('hide'); leaf.classList.add('notrans'); leaf.style.transform='rotateY(-180deg)';
      void leaf.offsetWidth; leaf.classList.remove('notrans'); leaf.style.transform='rotateY(0deg)';
    }
    leaf.addEventListener('transitionend', function(e){
      if(e.propertyName!=='transform' || !animating) return;
      var goingNext = leaf.style.transform.indexOf('-180')>-1;
      spread += goingNext ? 1 : -1;
      pageIndex=spread*2;
      render(); updateProjectUrl(); leaf.classList.add('hide'); leaf.style.transform=''; animating=false;
    });

    function syncBookLayout(){
      if(!modal.classList.contains('open')) return;
      animating=false;
      leaf.classList.add('hide'); leaf.classList.remove('notrans'); leaf.style.transform='';
      if(!isMobileBook()) spread=Math.floor(pageIndex/2);
      render();
    }
    if(mobileBookQuery.addEventListener) mobileBookQuery.addEventListener('change',syncBookLayout);
    else if(mobileBookQuery.addListener) mobileBookQuery.addListener(syncBookLayout);

    document.querySelectorAll('.spine[data-book]').forEach(function(sp){
      sp.addEventListener('click', function(){ openBook(sp.dataset.book,sp); });
    });
    nextButton.addEventListener('click', next);
    prevButton.addEventListener('click', prev);
    modal.querySelectorAll('[data-close]').forEach(function(el){ el.addEventListener('click', function(){closeBook();}); });
    function syncProjectFromUrl(){
      var target=projectFromUrl();
      if(!target){closeBook({history:false});return;}
      if(currentBookKey!==target.key || !modal.classList.contains('open')){
        openBook(target.key,null,{history:false,focus:false,page:target.index});
      }else{
        pageIndex=Math.max(0,Math.min(target.index,pageCount-1));
        spread=Math.floor(pageIndex/2); render();
      }
    }
    window.addEventListener('popstate',syncProjectFromUrl);
    window.addEventListener('hashchange',syncProjectFromUrl);
    syncProjectFromUrl();
    document.addEventListener('keydown', function(e){
      if(!modal.classList.contains('open')) return;
      if(e.key==='Escape') closeBook();
      else if(e.key==='Tab'){
        var focusable=focusableElements();
        if(!focusable.length){e.preventDefault();modal.focus();return;}
        var first=focusable[0], last=focusable[focusable.length-1];
        if(e.shiftKey && (document.activeElement===first || !modal.contains(document.activeElement))){e.preventDefault();last.focus();}
        else if(!e.shiftKey && document.activeElement===last){e.preventDefault();first.focus();}
      }
      else if(e.key==='ArrowRight') next();
      else if(e.key==='ArrowLeft') prev();
    });
  })();
</script>

<script is:inline>
  (function(){
    var toggle=document.getElementById('navToggle');
    var nav=document.getElementById('primary-nav');
    if(!toggle || !nav) return;

    function setOpen(open){
      nav.classList.toggle('open',open);
      toggle.setAttribute('aria-expanded',String(open));
    }

    toggle.addEventListener('click',function(){
      setOpen(toggle.getAttribute('aria-expanded')!=='true');
    });
    nav.addEventListener('click',function(e){
      if(e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape' && toggle.getAttribute('aria-expanded')==='true'){
        setOpen(false); toggle.focus();
      }
    });
    document.addEventListener('pointerdown',function(e){
      if(toggle.getAttribute('aria-expanded')==='true' && !nav.contains(e.target) && !toggle.contains(e.target)) setOpen(false);
    });
    window.addEventListener('resize',function(){
      if(window.innerWidth>760) setOpen(false);
    });
  })();

  var reducedMotionQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : {matches:false};
  var reducedMotion = reducedMotionQuery.matches;

  var hero = document.querySelector('.hero'), spot = document.getElementById('spot');
  if (hero) hero.addEventListener('pointermove', function(e){
    if(reducedMotion) return;
    var r = hero.getBoundingClientRect();
    spot.style.setProperty('--mx', ((e.clientX-r.left)/r.width*100)+'%');
    spot.style.setProperty('--my', ((e.clientY-r.top)/r.height*100)+'%');
  });

  // parallax por scroll y mouse, renderizado solo cuando cambia la escena
  var pnodes = Array.prototype.slice.call(document.querySelectorAll('.parallax'));
  var mobileParallaxQuery = window.matchMedia ? window.matchMedia('(max-width: 760px)') : {matches:false};
  function baseTop(el){var y=0,n=el;while(n){y+=n.offsetTop;n=n.offsetParent;}return y;}
  function refreshParallaxBases(){
    pnodes.forEach(function(el){el._base=baseTop(el);});
  }
  refreshParallaxBases();
  var mx=0,my=0;
  window.addEventListener('pointermove', function(e){
    if(!parallaxCanRun()) return;
    var clientX=Number.isFinite(e.clientX)?e.clientX:window.innerWidth/2;
    var clientY=Number.isFinite(e.clientY)?e.clientY:window.innerHeight/2;
    mx=(clientX/window.innerWidth-.5); my=(clientY/window.innerHeight-.5);
    scheduleParallax();
  },{passive:true});
  var parallaxFrame = null;
  var resizeFrame = null;
  function parallaxCanRun(){
    return !reducedMotion && !mobileParallaxQuery.matches && !document.hidden;
  }
  function resetParallax(){
    pnodes.forEach(function(el){
      el.style.removeProperty('--parallax-x');
      el.style.removeProperty('--parallax-y');
    });
  }
  function renderParallax(){
    parallaxFrame=null;
    if(!parallaxCanRun()) return;
    var sy = window.scrollY, vh = window.innerHeight;
    pnodes.forEach(function(el){
      var d = parseFloat(el.dataset.depth)||0;
      var center = el._base - sy + el.offsetHeight/2;
      var prog = (center - vh/2)/vh;
      var ty = prog * d * -1.4 + my*d*1.1;
      var tx = mx*d*1.5;
      if(!Number.isFinite(tx)||!Number.isFinite(ty)) return;
      el.style.setProperty('--parallax-x',tx+'px');
      el.style.setProperty('--parallax-y',ty+'px');
    });
  }
  function scheduleParallax(){
    if(parallaxCanRun() && parallaxFrame===null) parallaxFrame=requestAnimationFrame(renderParallax);
  }
  function stopParallax(){
    if(parallaxFrame!==null){cancelAnimationFrame(parallaxFrame);parallaxFrame=null;}
    resetParallax();
  }
  window.addEventListener('scroll',scheduleParallax,{passive:true});
  window.addEventListener('resize',function(){
    if(resizeFrame!==null) cancelAnimationFrame(resizeFrame);
    resizeFrame=requestAnimationFrame(function(){
      resizeFrame=null;
      refreshParallaxBases();
      if(parallaxCanRun()) scheduleParallax(); else stopParallax();
    });
  },{passive:true});
  document.addEventListener('visibilitychange',function(){
    if(document.hidden) stopParallax(); else scheduleParallax();
  });
  function applyMobileParallax(){
    if(mobileParallaxQuery.matches) stopParallax(); else scheduleParallax();
  }
  if(mobileParallaxQuery.addEventListener) mobileParallaxQuery.addEventListener('change',applyMobileParallax);
  else if(mobileParallaxQuery.addListener) mobileParallaxQuery.addListener(applyMobileParallax);
  function showReveals(){
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in');});
  }
  function applyMotionPreference(e){
    reducedMotion=e.matches;
    if(reducedMotion){stopParallax();showReveals();}
    else scheduleParallax();
  }
  if(reducedMotionQuery.addEventListener) reducedMotionQuery.addEventListener('change',applyMotionPreference);
  else if(reducedMotionQuery.addListener) reducedMotionQuery.addListener(applyMotionPreference);
  scheduleParallax();

  (function(){
    var yarnBall=document.querySelector('.yarn-ball');
    if(!yarnBall) return;
    function playYarn(){
      yarnBall.classList.remove('is-playing');
      if(reducedMotion) return;
      void yarnBall.offsetWidth;
      yarnBall.classList.add('is-playing');
    }
    yarnBall.addEventListener('click',playYarn);
    yarnBall.addEventListener('animationend',function(e){
      if(e.animationName==='yarn-ball-play') yarnBall.classList.remove('is-playing');
    });
  })();

  (function(){
    var els = document.querySelectorAll('.reveal');
    if(reducedMotion){showReveals();return;}
    if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('in');});return;}
    var io = new IntersectionObserver(function(en){
      en.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
    },{threshold:.14, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.patch').forEach(function(el,i){el.style.transitionDelay=(i*70)+'ms';});
    els.forEach(function(e){io.observe(e);});
  })();
</script>
