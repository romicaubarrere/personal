---
import { parseLegacyDocument } from '../lib/legacy-document';

interface Props {
  source: string;
}

const { source } = Astro.props;
const document = parseLegacyDocument(source);
---

<!doctype html>
<html lang={document.lang}>
  <head>
    <Fragment set:html={document.head} />
  </head>
  <body>
    <Fragment set:html={document.body} />
  </body>
</html>
