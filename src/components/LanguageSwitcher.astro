---
interface Props {
  current: 'es' | 'en' | 'pt';
  page?: 'home' | 'work' | 'community' | 'education' | 'questions' | 'when-you-can';
}

const { current, page = 'home' } = Astro.props;
const paths = {
  home: { es: '/personal/', en: '/personal/en.html', pt: '/personal/pt.html' },
  work: { es: '/personal/como-trabajo.html', en: '/personal/en/como-trabajo.html', pt: '/personal/pt/como-trabajo.html' },
  community: { es: '/personal/comunidad-charlas.html', en: '/personal/en/comunidad-charlas.html', pt: '/personal/pt/comunidad-charlas.html' },
  education: { es: '/personal/formacion.html', en: '/personal/en/formacion.html', pt: '/personal/pt/formacion.html' },
  questions: { es: '/personal/posts/por-que-hago-tantas-preguntas.html', en: '/personal/en/posts/why-do-i-ask-so-many-questions.html', pt: '/personal/pt/posts/por-que-faco-tantas-perguntas.html' },
  'when-you-can': { es: '/personal/posts/cuando-puedas.html', en: '/personal/en/posts/when-you-can.html', pt: '/personal/pt/posts/quando-puder.html' }
} as const;
const links = [
  { code: 'es', label: 'Español', href: paths[page].es },
  { code: 'en', label: 'English', href: paths[page].en },
  { code: 'pt', label: 'Português', href: paths[page].pt }
] as const;
---

<nav class="language-switcher" aria-label={current === 'es' ? 'Elegir idioma' : current === 'en' ? 'Choose language' : 'Escolher idioma'}>
  {links.map((link) => (
    <a href={link.href} lang={link.code} hreflang={link.code} aria-current={link.code === current ? 'page' : undefined} title={link.label}>
      <span aria-hidden="true">{link.code.toUpperCase()}</span>
      <span class="sr-only">{link.label}</span>
    </a>
  ))}
</nav>

<style>
  .language-switcher{position:fixed;z-index:130;top:10px;right:auto;bottom:auto;left:10px;width:max-content;display:flex;justify-content:flex-start;gap:3px;padding:0;background:transparent;border:0;box-shadow:none;transform:none;pointer-events:none}
  .language-switcher a{pointer-events:auto;position:static;top:auto;display:grid;place-items:center;width:30px;height:30px;min-width:30px;min-height:30px;padding:0;color:rgba(250,243,228,.52);font:800 9px/1 "DM Sans",sans-serif;letter-spacing:.05em;text-decoration:none;border:1px solid rgba(250,243,228,.16);border-radius:50%;background:rgba(22,19,16,.36);box-shadow:none;backdrop-filter:blur(3px);transition:opacity .16s ease,transform .16s ease,border-color .16s ease,color .16s ease}
  .language-switcher a:hover,.language-switcher a:focus-visible{top:auto;color:#faf3e4;border-color:rgba(250,243,228,.7);outline:none;transform:translateY(1px)}
  .language-switcher a[aria-current="page"]{color:#faf3e4;border-color:rgba(250,243,228,.48);background:rgba(34,67,44,.72)}
  @media(max-width:760px){
    .language-switcher{top:11px;right:auto;bottom:auto;left:10px;width:max-content;gap:2px}
    .language-switcher a{width:27px;height:27px;min-width:27px;min-height:27px;font-size:8px;opacity:.66}
    .language-switcher a:focus-visible,.language-switcher a:hover{opacity:1}
  }
  @media(prefers-reduced-motion:reduce){.language-switcher a{transition:none}}
</style>
