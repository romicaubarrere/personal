---
import { HOME_COPY, type HomeLanguage } from '../../data/home-copy';
interface Props { lang?: HomeLanguage }
const { lang = 'es' } = Astro.props;
const copy = HOME_COPY[lang];
---
  <a class="skip-link" href="#main-content">{copy.skip}</a>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <g id="frond" fill="none" stroke-linecap="round">
        <path d="M2 0 Q10 76 2 156
          M2 10 l-14.6 9.4 M2 10 l14.6 9.4
          M2 19 l-14.6 9.4 M2 19 l14.6 9.4
          M2 28 l-13.8 8.8 M2 28 l13.8 8.8
          M2 37 l-12.9 8.3 M2 37 l12.9 8.3
          M2 46 l-12 7.7 M2 46 l12 7.7
          M2 55 l-11.2 7.2 M2 55 l11.2 7.2
          M2 64 l-10.3 6.6 M2 64 l10.3 6.6
          M2 73 l-9.5 6.1 M2 73 l9.5 6.1
          M2 82 l-8.6 5.5 M2 82 l8.6 5.5
          M2 91 l-7.7 5 M2 91 l7.7 5
          M2 100 l-6.9 4.4 M2 100 l6.9 4.4
          M2 109 l-6 3.9 M2 109 l6 3.9
          M2 118 l-5.2 3.3 M2 118 l5.2 3.3
          M2 127 l-4.3 2.8 M2 127 l4.3 2.8
          M2 136 l-3.4 2.2 M2 136 l3.4 2.2
          M2 144 l-2.6 1.7 M2 144 l2.6 1.7"/>
      </g>
      <g id="fern">
        <path d="M106 6 L110 54 M134 6 L130 54" stroke="#161310" stroke-width="2" fill="none"/>
        <ellipse cx="120" cy="7" rx="10" ry="4" fill="none" stroke="#161310" stroke-width="2"/>
        <path d="M100 54 h40 l-5 20 h-30 z" fill="#5a3d22" stroke="#161310" stroke-width="2"/>
        <path d="M98 54 h44" stroke="#161310" stroke-width="3"/>
        <g transform="translate(120 72)">
          <g opacity="0.5" stroke-width="2" stroke="#3f4a2c">
            <use href="#frond" transform="rotate(-58) scale(0.95)"/>
            <use href="#frond" transform="rotate(-34) scale(1.08)"/>
            <use href="#frond" transform="rotate(-10) scale(1.16)"/>
            <use href="#frond" transform="rotate(14) scale(1.12)"/>
            <use href="#frond" transform="rotate(38) scale(1.02)"/>
            <use href="#frond" transform="rotate(58) scale(0.95)"/>
          </g>
          <g stroke-width="2.1">
            <use href="#frond" transform="rotate(-66) scale(0.8)" stroke="#4f5a37"/>
            <use href="#frond" transform="rotate(-52) scale(0.88)" stroke="#6f7a54"/>
            <use href="#frond" transform="rotate(-40) scale(0.95)" stroke="#5c6b3f"/>
            <use href="#frond" transform="rotate(-28) scale(1)" stroke="#6f7a54"/>
            <use href="#frond" transform="rotate(-16) scale(1.05)" stroke="#5c6b3f"/>
            <use href="#frond" transform="rotate(-4) scale(1.08)" stroke="#6f7a54"/>
            <use href="#frond" transform="rotate(8) scale(1.08)" stroke="#5c6b3f"/>
            <use href="#frond" transform="rotate(20) scale(1.04)" stroke="#6f7a54"/>
            <use href="#frond" transform="rotate(32) scale(0.98)" stroke="#5c6b3f"/>
            <use href="#frond" transform="rotate(46) scale(0.9)" stroke="#6f7a54"/>
            <use href="#frond" transform="rotate(62) scale(0.8)" stroke="#4f5a37"/>
          </g>
        </g>
      </g>
      <g id="vine">
        <path d="M50 0 C42 50 58 90 46 140 C38 180 56 210 50 258" fill="none" stroke="#4f5a37" stroke-width="2.5"/>
        <g stroke="#3f5233" stroke-width="0.8">
          <ellipse cx="42" cy="30" rx="7.5" ry="10.5" transform="rotate(-34 42 30)" fill="#6f7a54"/>
          <ellipse cx="58" cy="58" rx="7.5" ry="10.5" transform="rotate(30 58 58)" fill="#5c6b3f"/>
          <ellipse cx="41" cy="90" rx="7.5" ry="10.5" transform="rotate(-32 41 90)" fill="#6f7a54"/>
          <ellipse cx="57" cy="120" rx="7" ry="10" transform="rotate(28 57 120)" fill="#55603f"/>
          <ellipse cx="42" cy="150" rx="7" ry="10" transform="rotate(-30 42 150)" fill="#6f7a54"/>
          <ellipse cx="56" cy="182" rx="6.5" ry="9" transform="rotate(30 56 182)" fill="#5c6b3f"/>
          <ellipse cx="45" cy="212" rx="6" ry="8" transform="rotate(-28 45 212)" fill="#55603f"/>
          <ellipse cx="51" cy="240" rx="5.5" ry="7.5" transform="rotate(20 51 240)" fill="#6f7a54"/>
