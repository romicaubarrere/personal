---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/home/Footer.astro';
import { readingHistory, readingStats } from '../data/reading';
import { displayedCurrentReading, recentCoverByTitle, visibleReadingLimit } from '../data/reading-display';
import '../styles/home.css';

const title = 'Notas y lecturas | Romina Caubarrere';
const description = 'Notas personales, lectura actual y una selección reciente de libros de Romina Caubarrere, con algunas estadísticas de lectura.';
const canonical = 'https://romicaubarrere.github.io/personal/lecturas.html';
const recentReading = readingHistory.slice(0, visibleReadingLimit);
const notes = [
  {
    title: '¿Por qué hago tantas preguntas?',
    description: 'Sobre preguntar por qué, caer en rabbit holes y tener una memoria especial para las cosas pelotudas.',
    href: '/personal/posts/por-que-hago-tantas-preguntas.html',
    label: 'curiosidad, preguntas y rabbit holes'
  },
  {
    title: 'Cuando puedas (cuando en realidad necesito que sea hoy)',
    description: 'Sobre feedback, mensajes de tres líneas y aprender a bancarme un poco la incomodidad.',
    href: '/personal/posts/cuando-puedas.html',
    label: 'comunicación, claridad y feedback'
  }
];

function formatDate(value) {
  if (!value) return null;
  const [year, month, day] = value.split('-').map(Number);
  if (!year || !month || !day) return value;
  return new Intl.DateTimeFormat('es-UY', {
    day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Montevideo'
  }).format(new Date(Date.UTC(year, month - 1, day, 12)));
}
---

<style is:inline>
  .reading-page{min-height:100vh;background:var(--cork);color:var(--ink);padding:86px 20px 56px}
  .reading-desk{width:min(1060px,100%);margin:0 auto}
  .reading-back{display:inline-flex;align-items:center;min-height:44px;margin-bottom:24px;padding:8px 13px;background:var(--cream);color:var(--green-dark);font-family:var(--sans);font-weight:700;text-decoration:none;box-shadow:3px 4px 0 rgba(36,31,24,.2);transform:rotate(-1deg);transition:transform .18s ease}
  .reading-back:is(:hover,:focus-visible){transform:rotate(0) translateY(-2px)}
  .reading-hero{position:relative;padding:38px clamp(24px,6vw,72px) 42px;background:var(--cream);box-shadow:8px 12px 28px rgba(36,31,24,.24);transform:rotate(.25deg)}
  .reading-hero::before{content:"";position:absolute;top:-12px;left:17%;width:92px;height:26px;background:rgba(229,205,153,.82);transform:rotate(-4deg)}
  .reading-kicker{font-family:var(--hand);font-size:1.25rem;color:var(--warm)}
  .reading-hero h1{max-width:760px;margin:6px 0 14px;font-family:var(--serif);font-size:clamp(2.4rem,7vw,5.4rem);line-height:.94;font-weight:600}
  .reading-hero h1 em{color:var(--green);font-weight:400}
  .reading-intro{max-width:700px;font-size:1.04rem;line-height:1.7}
  .writing-section{margin-top:48px}
  .writing-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:25px;margin-top:22px}
  .writing-note{position:relative;display:flex;flex-direction:column;min-height:260px;padding:30px 29px 27px;background:var(--cream);color:var(--ink);text-decoration:none;box-shadow:6px 9px 0 rgba(36,31,24,.17);transform:rotate(var(--note-r,-1deg));transition:transform .2s ease,box-shadow .2s ease}
  .writing-note:nth-child(2){--note-r:1.1deg;background:#eef3df;margin-top:18px}
  .writing-note::before{content:"";position:absolute;top:-12px;left:50%;width:86px;height:25px;background:rgba(207,154,63,.58);transform:translateX(-50%) rotate(2deg)}
  .writing-note::after{content:"";position:absolute;left:22px;right:22px;bottom:21px;border-bottom:1px dashed rgba(36,31,24,.24)}
  .writing-note:is(:hover,:focus-visible){transform:rotate(0) translateY(-7px);box-shadow:8px 15px 0 rgba(36,31,24,.15)}
  .writing-note small{font-family:var(--hand);font-size:1.08rem;color:var(--warm)}
  .writing-note h2{margin:13px 0 11px;font-family:var(--serif);font-size:clamp(1.7rem,3.5vw,2.5rem);line-height:1.04}
  .writing-note p{max-width:560px;line-height:1.65;color:var(--ink-soft)}
  .reading-section{margin-top:54px}
  .reading-section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:20px}
  .reading-section h2{font-family:var(--serif);font-size:clamp(2rem,5vw,3.5rem);font-weight:500}
  .reading-section-head p{max-width:420px;font-family:var(--hand);font-size:1.15rem;color:var(--ink-soft)}
  .reading-now{display:grid;grid-template-columns:145px 1fr;gap:24px;align-items:center;padding:23px;background:#f1d3c8;border-left:7px solid var(--warm);box-shadow:4px 6px 0 rgba(36,31,24,.12)}
  .reading-now-cover{width:145px;aspect-ratio:2/3;object-fit:cover;box-shadow:5px 7px 0 rgba(36,31,24,.2)}
  .reading-now strong{display:block;font-family:var(--serif);font-size:clamp(1.7rem,4vw,2.6rem);line-height:1.02}.reading-now span,.reading-now time{display:block;margin-top:6px;color:var(--ink-soft)}
  .reading-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;list-style:none;margin-top:20px}.reading-stat{min-height:136px;padding:21px;background:var(--cream);border-top:7px solid var(--green);box-shadow:4px 5px 0 rgba(36,31,24,.16)}
  .reading-stat strong{display:block;font-family:var(--serif);font-size:2.2rem;font-weight:500}.reading-stat span{display:block;margin-top:7px;line-height:1.45;color:var(--ink-soft)}
  .reading-history{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;list-style:none;margin-top:20px}
  .reading-card{height:100%;padding:10px 10px 18px;background:var(--cream);box-shadow:4px 6px 0 rgba(36,31,24,.15);transform:rotate(var(--tilt,-.35deg));transition:transform .18s ease,box-shadow .18s ease}
  .reading-card:hover{transform:rotate(0) translateY(-5px);box-shadow:6px 10px 0 rgba(36,31,24,.13)}
  .reading-card img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:var(--paper2)}
  .reading-card h3{margin:13px 4px 0;font-family:var(--serif);font-size:1.05rem;line-height:1.08}.reading-card p{margin:5px 4px 0;color:var(--ink-soft);font-size:.85rem}.reading-meta{display:flex;flex-wrap:wrap;gap:6px;margin:11px 4px 0}.reading-meta span,.reading-meta time{padding:3px 6px;background:#e8dfbd;font-size:.75rem}
  .reading-close{margin-top:28px;font-family:var(--hand);font-size:1.15rem;color:var(--ink-soft)}
  @media(max-width:900px){.reading-history{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:720px){.reading-page{padding:72px 14px 40px}.reading-hero{padding:30px 20px 34px}.writing-grid{grid-template-columns:1fr}.writing-note:nth-child(2){margin-top:0}.reading-section-head{display:block}.reading-section-head p{margin-top:7px}.reading-now{grid-template-columns:95px 1fr}.reading-now-cover{width:95px}.reading-stats{grid-template-columns:1fr}.reading-stat{min-height:auto}.reading-history{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:430px){.reading-history{grid-template-columns:1fr}.reading-card{display:grid;grid-template-columns:100px 1fr;gap:12px;padding:10px}.reading-card img{grid-row:1 / span 3}.reading-card h3{margin-top:8px}}
  @media(prefers-reduced-motion:reduce){.reading-back,.reading-hero,.writing-note,.reading-card{transform:none!important;transition:none!important}}
</style>

<BaseLayout {title} {description} {canonical}>
  <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
  <main class="reading-page" id="main-content" tabindex="-1">
    <div class="reading-desk">
      <a class="reading-back" href="/personal/#lecturas">← Volver al estudio</a>

      <header class="reading-hero">
        <span class="reading-kicker">cosas que anoto y cosas que subrayo</span>
        <h1>Primero escribo. Después, <em>leo</em>.</h1>
        <p class="reading-intro">Mis notas tienen su propio lugar porque cuentan bastante de cómo pienso. Más abajo queda el estante: qué estoy leyendo, las últimas cinco lecturas y algunas cuentas que me divierte llevar.</p>
      </header>

      <section class="writing-section" aria-labelledby="writing-title">
        <span class="reading-kicker">mis notas</span>
        <div class="writing-grid" id="writing-title">
          {notes.map((note) => (
            <a class="writing-note" href={note.href} aria-label={`Leer ${note.title}`}>
              <small>{note.label}</small>
              <h2>{note.title}</h2>
              <p>{note.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="reading-section" aria-labelledby="now-title">
        <div class="reading-section-head">
          <h2 id="now-title">Leyendo ahora</h2>
          <p>el libro que está abierto hoy</p>
        </div>
        <div class="reading-now">
          <img class="reading-now-cover" src={displayedCurrentReading.coverUrl} alt={displayedCurrentReading.coverAlt} referrerpolicy="no-referrer" />
          <div>
            <span class="reading-kicker">ahora mismo</span>
            <strong>{displayedCurrentReading.title}</strong>
            <span>de {displayedCurrentReading.author}</span>
            <time datetime={displayedCurrentReading.updatedAt}>actualizado el {displayedCurrentReading.updatedLabel}</time>
          </div>
        </div>
      </section>

      {readingStats && (
        <section class="reading-section" aria-labelledby="stats-title">
          <div class="reading-section-head">
            <h2 id="stats-title">Las cuentas del margen</h2>
            <p>sí, hasta esto mido</p>
          </div>
          <ul class="reading-stats">
            <li class="reading-stat"><strong>{readingStats.totalFinished}</strong><span>lecturas terminadas registradas</span></li>
            <li class="reading-stat"><strong>{readingStats.ratedCount}</strong><span>con valoración registrada</span></li>
            <li class="reading-stat"><strong>{readingStats.averageRating ?? '—'}</strong><span>promedio entre las que sí tienen valoración</span></li>
          </ul>
        </section>
      )}

      <section class="reading-section" aria-labelledby="history-title">
        <div class="reading-section-head">
          <h2 id="history-title">Las últimas cinco</h2>
          <p>el resto puede quedarse en el estante</p>
        </div>
        <ol class="reading-history">
          {recentReading.map((book, index) => {
            const cover = recentCoverByTitle[book.title];
            return (
              <li>
                <article class="reading-card" style={`--tilt:${index % 2 ? '.35deg' : '-.35deg'}`}>
                  {cover && <img src={cover.url} alt={cover.alt} loading="lazy" referrerpolicy="no-referrer" />}
                  <h3>{book.title}</h3>
                  <p>de {book.author}</p>
                  <div class="reading-meta">
                    {'finishedAt' in book && book.finishedAt && <time datetime={book.finishedAt}>{formatDate(book.finishedAt)}</time>}
                    {'rating' in book && typeof book.rating === 'number' && <span>{book.rating}/5</span>}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
        <p class="reading-close">Cinco alcanzan para contar qué viene pasando por mi mesa sin convertir esto en un catálogo infinito.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
