const copy = ({ work, community, education } as const)[page][lang];
const path = `${lang}/${slug}.html`;
const canonical = `${base}${path}`;
const alternates = [
  {lang:'es',href:`${base}${slug}.html`},{lang:'en',href:`${base}en/${slug}.html`},{lang:'pt',href:`${base}pt/${slug}.html`},{lang:'x-default',href:`${base}${slug}.html`}
];
const pageLabel = page === 'work' ? 'work' : page === 'community' ? 'community' : 'education';
---

<BaseLayout lang={lang} ogLocale={lang === 'en' ? 'en_US' : 'pt_BR'} title={copy.title} description={copy.description} {canonical} {alternates}>
  <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to main content' : 'Pular para o conteúdo principal'}</a>
  <LanguageSwitcher current={lang} page={page} />
  <div class="topbar localized-topbar"><a href={`/${'personal'}/${lang}.html`}>&larr; {lang === 'en' ? 'Back to the studio' : 'Voltar ao estúdio'}</a><nav aria-label={lang === 'en' ? 'Page sections' : 'Seções da página'}>{copy.sections.map(section => <a href={`#${section.id}`}>{section.eyebrow}</a>)}</nav></div>
  <header class="academic-hero brick" id="inicio"><div class="hero-inner"><div class="open-folder" data-label={pageLabel}><div class="folder-pages"><div class="hero-copy"><span class="kick">{copy.kicker}</span><h1>{copy.heading}</h1><p>{copy.lede}</p></div><aside class="file-card"><span class="label">{copy.record}</span><h2>{copy.title.split('|')[0]}</h2><p class="spoiler">{copy.note}</p><div class="file-stamps"><span>ES</span><span>{lang.toUpperCase()}</span><span>{lang === 'en' ? 'PT available' : 'EN disponível'}</span></div></aside></div></div></div></header>
  <main id="main-content" tabindex="-1">
    {copy.sections.map((section, sectionIndex) => <section class={sectionIndex % 2 ? 'academic-projects' : 'route'} id={section.id}><div class={sectionIndex % 2 ? 'projects-inner' : 'route-inner'}><div class="section-title"><span class="small">{section.eyebrow}</span><h2>{section.title}</h2><p>{section.intro}</p></div><div class="project-stack">{section.items.map((item,index) => <article class="project-sheet" style={`grid-column:span 6;--sheet-rotate:${index % 2 ? '.6deg' : '-.6deg'};${index % 2 ? 'background:#eef3df' : ''}`}><div class="code">{item.meta || String(index + 1).padStart(2,'0')}</div><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></div></section>)}
  </main>
  <footer><p>{copy.note}</p><a href={`/${'personal'}/${lang}.html`}>{copy.footer}</a></footer>
  <script is:inline>
  (function(){
    var sectionLinks=Array.prototype.slice.call(document.querySelectorAll('.topbar nav a'));
    var sections=sectionLinks.map(function(link){return document.querySelector(link.getAttribute('href'));}).filter(Boolean);
    if(!('IntersectionObserver' in window)) return;
    var observer=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        sectionLinks.forEach(function(link){
          var active=link.getAttribute('href')==='#'+entry.target.id;
          if(active) link.setAttribute('aria-current','location');
          else link.removeAttribute('aria-current');
        });
      });
    },{rootMargin:'-25% 0px -60%',threshold:0});
    sections.forEach(function(section){observer.observe(section);});
  })();
  </script>
</BaseLayout>
